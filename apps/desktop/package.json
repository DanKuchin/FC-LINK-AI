{
  "name": "@tenure/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "node scripts/clean.mjs && vite build && vite build --config vite.main.config.ts && tsc -p tsconfig.preload.json && node scripts/copy-runtime-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "vite": "^8.1.5"
  }
}
