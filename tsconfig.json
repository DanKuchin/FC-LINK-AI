{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@tenure/domain/*": ["packages/domain/*"],
      "@tenure/sim/*": ["packages/sim/*"],
      "@tenure/sync/*": ["packages/sync/*"],
      "@tenure/persistence/*": ["packages/persistence/*"],
      "@tenure/narrative/*": ["packages/narrative/*"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "tools/**/*.ts", "vitest.config.ts"]
}
